+
 #include <mgba-util/vfs.h>
 #include <mgba/core/log.h>
 #include <mgba/core/timing.h>
@@ -455,6 +460,67 @@ void Core::AddCallbacks()
   };
   callbacks.videoFrameEnded = [](void* context) {
     auto core = static_cast<Core*>(context);
+    // Analysis hook: save each GBA frame (8-byte frame index + 240x160 XBGR) when GBA_DUMP_DIR is set.
+    if (const char* dir = std::getenv("GBA_DUMP_DIR"))
+    {
+      static unsigned long long frames[4] = {0, 0, 0, 0};
+      const int dev = static_cast<int>(core->m_device_number) & 3;
+      const unsigned long long idx = frames[dev]++;
+      const std::string base = std::string(dir) + "/gba" + std::to_string(dev + 1);
+      auto write = [&](const std::string& path) {
+        if (FILE* f = std::fopen((path + ".tmp").c_str(), "wb"))
+        {
+          std::fwrite(&idx, 8, 1, f);
+          std::fwrite(core->m_video_buffer.data(), 4, core->m_video_buffer.size(), f);
+          std::fclose(f);
+          std::rename((path + ".tmp").c_str(), path.c_str());
+        }
+      };
+      write(base + ".raw");
+      // Optional compact log: while <dir>/LOG exists, append frame index + OAM + palette + IWRAM to gbaN.log.
+      struct stat lst;
+      if (stat((std::string(dir) + "/LOG").c_str(), &lst) == 0)
+      {
+        if (FILE* f = std::fopen((base + ".log").c_str(), "ab"))
+        {
+          std::fwrite(&idx, 8, 1, f);
+          auto dump = [&](u32 addr, u32 size) {
+            std::vector<u32> buf(size / 4);
+            for (u32 i = 0; i < size / 4; i++)
+              buf[i] = core->m_core->busRead32(core->m_core, addr + i * 4);
+            std::fwrite(buf.data(), 4, buf.size(), f);
+          };
+          dump(0x07000000, 0x400);
+          dump(0x05000000, 0x400);
+          dump(0x03000000, 0x8000);
+          std::fclose(f);
+        }
+      }
+      // Optional memory dump: EWRAM + IWRAM + OAM + palette, one file per frame while <dir>/MEM exists.
+      struct stat mst;
+      if (stat((std::string(dir) + "/MEM").c_str(), &mst) == 0)
+      {
+        const std::string path = base + "_mem_" + std::to_string(idx) + ".bin";
+        if (FILE* f = std::fopen(path.c_str(), "wb"))
+        {
+          std::fwrite(&idx, 8, 1, f);
+          auto dump = [&](u32 addr, u32 size) {
+            std::vector<u32> buf(size / 4);
+            for (u32 i = 0; i < size / 4; i++)
+              buf[i] = core->m_core->busRead32(core->m_core, addr + i * 4);
+            std::fwrite(buf.data(), 4, buf.size(), f);
+          };
+          dump(0x02000000, 0x40000);  // EWRAM
+          dump(0x03000000, 0x8000);   // IWRAM
+          dump(0x07000000, 0x400);    // OAM
+          dump(0x05000000, 0x400);    // palette
+          std::fclose(f);
+        }
+      }
+      struct stat st;
+      if (stat((std::string(dir) + "/RECORD").c_str(), &st) == 0)
+        write(base + "_" + std::to_string(idx) + ".raw");
+    }
     if (auto host = core->m_host.lock())
       host->FrameEnded(core->m_video_buffer);
   };
